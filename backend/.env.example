# Copy to backend/.env and fill in. Every value here has a working default
# except MODEL_API_KEY, which you must supply. See docs/self-hosting.md.

# --- AI ---------------------------------------------------------------
# Your Anthropic API key: https://console.anthropic.com/settings/keys
MODEL_API_KEY=

# --- persistence ------------------------------------------------------
# SQLite needs no setup and is fine for a single user. For Postgres use:
#   postgresql+psycopg://user:password@host:5432/tome
# docker compose overrides this to point at the bundled db service.
DATABASE_URL=sqlite:///./tome.db

# Where the vector store keeps its files.
CHROMA_PERSIST_DIR=./chroma_data

# --- logging ----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=WARNING

# --- Scryfall importer ------------------------------------------------
# Scryfall requires a User-Agent identifying your application. Please change
# this if you're running a modified or public deployment.
# SCRYFALL_USER_AGENT=Tome/0.1.0 (+https://github.com/harrisspeed/Tome)

# Which bulk file to import. oracle_cards is one entry per unique card and is
# what the Card model expects; default_cards/all_cards add printings and
# languages we don't store.
# SCRYFALL_BULK_TYPE=oracle_cards

# Scryfall API root. Only worth changing to point at a mock/proxy in tests.
# SCRYFALL_API_BASE=https://api.scryfall.com

# Where downloaded bulk archives are cached (~24 MB per snapshot).
# SCRYFALL_CACHE_DIR=./data/scryfall

# Rows per database batch during import.
# IMPORT_BATCH_SIZE=1000
