# Copy to backend/.env and fill in. See docs/self-hosting.md#configuration.
#
# Two separate settings classes, not one list: LocalSettings (the client
# plane -- what a normal install uses) and KnowledgeSettings (the knowledge
# plane -- only needed if you run your own corpus instead of the hosted one).
# A bare DATABASE_URL is rejected at startup on purpose (see config.py) --
# Tome has two databases now, and that name can't say which one you meant.

# =========================================================================
# Client settings -- what a normal install uses
# =========================================================================

# --- AI: your deck-generation model -------------------------------------
# Your Anthropic API key: https://console.anthropic.com/settings/keys
MODEL_API_KEY=

# --- persistence ----------------------------------------------------------
# Your collection and decks. Never leaves this machine. SQLite needs no
# setup and is fine for a single user; for Postgres use:
#   postgresql+psycopg://user:password@host:5432/tome
LOCAL_DATABASE_URL=sqlite:///./tome.db

# --- the knowledge plane, as a dependency ---------------------------------
# Where card data and candidates come from. Defaults to a locally-run
# knowledge service; point this at the hosted service, or your own, once you
# have a URL for one.
# KNOWLEDGE_API_URL=http://localhost:8001

# --- logging ----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=WARNING

# =========================================================================
# Knowledge-plane settings -- only if you run your own corpus
# (docs/self-hosting.md#running-your-own-knowledge-plane)
# =========================================================================

# --- persistence ----------------------------------------------------------
# The cloud Postgres holding the shared card corpus. Needs pgvector. No
# default on purpose: an unset value must fail loudly rather than quietly
# writing card data into some other database.
# KNOWLEDGE_DATABASE_URL=postgresql+psycopg://user:password@host:5432/tome_knowledge

# --- Scryfall importer ------------------------------------------------
# Scryfall requires a User-Agent identifying your application. Please change
# this if you're running a modified or public deployment.
# SCRYFALL_USER_AGENT=Tome/0.1.0 (+https://github.com/harrisspeed/Tome)

# Which bulk file to import. oracle_cards is one entry per unique card and is
# what the Card model expects; default_cards/all_cards add printings and
# languages we don't store.
# SCRYFALL_BULK_TYPE=oracle_cards

# Scryfall API root. Only worth changing to point at a mock/proxy in tests.
# SCRYFALL_API_BASE=https://api.scryfall.com

# Where downloaded bulk archives are cached (~24 MB per snapshot).
# SCRYFALL_CACHE_DIR=./data/scryfall

# Rows per database batch during import.
# IMPORT_BATCH_SIZE=1000

# --- metadata generation ------------------------------------------------
# Maintainer-only credential for backend/knowledge_pipeline/metadata_generator.py.
# Separate from MODEL_API_KEY above -- that one is the *user's* chosen deck-
# generation provider; this one drives the pipeline stage that writes
# card_metadata, and has no user-facing configuration at all.
# METADATA_MODEL_API_KEY=

# METADATA_MODEL_NAME=claude-opus-5

# Output ceiling per card -- CardMetadata is a handful of short fields, far
# below MODEL_MAX_TOKENS's deck-construction default.
# METADATA_MODEL_MAX_TOKENS=2048

# Rows per database batch while writing card_metadata.
# METADATA_BATCH_SIZE=50
