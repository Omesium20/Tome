# Copy to `.env` for local dev. Vite only exposes variables prefixed with VITE_
# to client code via import.meta.env, and inlines them at build time — so these
# are baked into the bundle, not read at container startup. In Docker they're
# passed as build args (see frontend/Dockerfile and Dockercompose.yaml).

# Where the FastAPI backend lives. Must be reachable from the browser, so use a
# host-published URL — not a Docker service name.
VITE_API_BASE_URL=http://localhost:8000

# Mocks are on unless this is exactly "false" (backend routes are still stubs).
VITE_USE_MOCKS=true
